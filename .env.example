# Configuração do servidor Ollama (API nativa na porta 11434)
OLLAMA_HOST=http://127.0.0.1:11434
# Opcional: define manualmente quantas camadas enviar para a GPU (ex: 99). Se omitido, o Ollama gerencia automaticamente.
# OLLAMA_NUM_GPU=99

# Configuração do Banco de Dados MariaDB / MySQL
DB_HOST=localhost
DB_NAME=chat_app
DB_USER=ubuntu
DB_PASS=sua_senha_aqui
